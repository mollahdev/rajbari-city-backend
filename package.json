{
  "private": true,
  "engines": {
    "node": "v20.18.0",
    "npm": "10.8.2"
  },
  "scripts": {
    "start": "node api.js && node server.js",
    "dev": "node api.js && node --watch server.js",
    "format": "prettier --write .",
    "migrate": "npx sequelize-cli db:migrate",
    "prepare": "husky"
  },
  "_moduleAliases": {
    "@": "."
  },
  "dependencies": {
    "@fastify/cors": "11.1.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/jwt": "9.0.4",
    "@fastify/multipart": "9.0.3",
    "@sequelize/core": "7.0.0-alpha.46",
    "aws-sdk": "2.1692.0",
    "bcryptjs": "3.0.1",
    "dayjs": "1.11.13",
    "dotenv": "^16.4.7",
    "expo-server-sdk": "3.15.0",
    "fastify": "5.2.1",
    "fastify-jwt": "4.2.0",
    "fastify-plugin": "5.0.1",
    "fastify-socket.io": "5.1.0",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "module-alias": "2.2.3",
    "mysql2": "3.12.0",
    "sequelize": "6.37.5",
    "sequelize-cli": "6.6.2",
    "sharp": "0.33.5",
    "socket.io": "4.8.1",
    "yup": "1.6.1"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,html}": "prettier --write"
  }
}
