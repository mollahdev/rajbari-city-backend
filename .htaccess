DirectoryIndex disabled
RewriteEngine On

# WebSocket support for dev-api.flexlab.studio
RewriteCond %{HTTP_HOST} ^dev-api\.flexlab\.studio$ [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:3000/$1 [P,L]

# HTTP support for dev-api.flexlab.studio
RewriteCond %{HTTP_HOST} ^dev-api\.flexlab\.studio$ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]

# WebSocket support for api.flexlab.studio
RewriteCond %{HTTP_HOST} ^api\.flexlab\.studio$ [NC]
RewriteCond %{HTTP:Upgrade} =websocket [NC]
RewriteRule ^(.*)$ ws://127.0.0.1:11000/$1 [P,L]

# HTTP support for api.flexlab.studio
RewriteCond %{HTTP_HOST} ^api\.flexlab\.studio$ [NC]
RewriteRule ^(.*)$ http://127.0.0.1:11000/$1 [P,L]
